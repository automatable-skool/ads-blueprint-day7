# Google Ads API credentials - /api-setup walks you through getting every one of these.
# Copy this file to .env and fill in. NEVER commit .env or share these values.

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# Your business (used by asset/ad and landing page scripts)
BUSINESS_NAME=
SITE_BASE_URL=

# Your market. COUNTRY is the two-letter code customers search from (US, CA, GB, AU, NZ, IE). Every
# geo-dependent script reads it, falling back to "Country customers search from" in context/business.md.
# MAIN_CITY is the ONE city the ads name when Google cannot place the searcher - the fallback in every
# pinned headline and landing page H1. Write none for a remote or national business.
COUNTRY=
MAIN_CITY=

# The three lead destinations. /landing-page asks for all three in its first
# message and refuses to publish a page with any of them missing.
LEAD_WEBHOOK_URL=          # GHL: Automation > new workflow > trigger "Inbound Webhook"
BUSINESS_PHONE=            # the one real number, no pools, same format everywhere
GHL_CALENDAR_URL=          # GHL: Calendars > the booking calendar > embed/scheduling link

# Google tag ID, AW-XXXXXXXXX. Google Ads > Tools > Data manager > Google tag.
GOOGLE_TAG_ID=

# Assets (/write-ads, code/push_assets.py). Optional - the script names whatever is missing.
BUSINESS_NAME_ASSET=       # the business-name asset: your VERIFIED domain root or legal entity, e.g. acme.co
LOGO_PATH=                 # square PNG or JPG, 1200x1200, for the logo asset - never generated for you
PRIVACY_POLICY_URL=        # the lead form's privacy policy link
LEAD_WEBHOOK_SECRET=       # the lead form's webhook secret, from the same GHL inbound webhook
MESSAGE_NUMBER=            # the number that receives message-asset replies - falls back to BUSINESS_PHONE

# Optional: Anthropic API key, only for /search-terms on a big account. Without it the judge step
# writes the terms to a file and Claude Code judges them in the session - no key needed. With it,
# `python3 code/judge_terms.py --api` judges thousands of terms in one go. console.anthropic.com > API keys.
ANTHROPIC_API_KEY=

# Optional: Apify token for the /proof-file social sweep (free tier works)
APIFY_TOKEN=

# Optional: Supabase, for /proposal - one row per client proposal, read at request time.
# Settings > API for the first two. Connect > Session pooler for the DB URL (first-run table setup only).
# NEVER prefix these with NEXT_PUBLIC_ - that ships every client's pricing to every visitor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
